{
  "name": "@fungi.computer/graft",
  "version": "0.2.66",
  "description": "ACP v1 projection for an authorized Shiitake Session",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "smoke": "node test/stranger/runtime.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/mule": "0.4.0",
    "@fungi.computer/shiitake": "0.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "author": "Levi <levi@technomancy.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/graft.git"
  }
}
